{
  "name": "codex-ubuntu-notifications",
  "displayName": "Codex Ubuntu Notifications",
  "publisher": "KaroTechnica",
  "author": {
    "name": "KaroTechnica",
    "url": "https://github.com/stiansci"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stiansci/Codex_Ubuntu_Notifications.git"
  },
  "version": "1.1.28",
  "description": "Desktop completion notifications, optional answer previews and audio for local Codex workspaces on Ubuntu, with dependency diagnostics.",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:codexNotifier.sidebarView"
  ],
  "icon": "codex-notifier.png",
  "main": "./extension.js",
  "contributes": {
    "taskDefinitions": [
      {
        "type": "codexNotifier.dependencies",
        "required": [],
        "properties": {
          "runId": {
            "type": "string",
            "description": "Identifier for a dependency setup run."
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexNotifierContainer",
          "title": "Codex Ubuntu Notifications",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "codexNotifierContainer": [
        {
          "type": "webview",
          "id": "codexNotifier.sidebarView",
          "name": "Codex Ubuntu Notifications"
        }
      ]
    },
    "commands": [
      {
        "command": "codexNotifier.testNotification",
        "title": "Codex Ubuntu Notifications: Send Test Notification"
      },
      {
        "command": "codexNotifier.importSound",
        "title": "Codex Ubuntu Notifications: Import Custom Sound File"
      },
      {
        "command": "codexNotifier.checkConfiguration",
        "title": "Codex Ubuntu Notifications: Check Configuration"
      },
      {
        "command": "codexNotifier.installDependencies",
        "title": "Codex Ubuntu Notifications: Install Missing Dependencies"
      }
    ],
    "configuration": {
      "title": "Codex Ubuntu Notifications",
      "properties": {
        "codexNotifier.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable notifications when Codex finishes answering a turn.",
          "scope": "machine"
        },
        "codexNotifier.mode": {
          "type": "string",
          "enum": [
            "always",
            "unfocused"
          ],
          "default": "always",
          "description": "When to notify: 'always' (even when VS Code is focused) or 'unfocused' (only when VS Code is in the background).",
          "scope": "machine"
        },
        "codexNotifier.desktopNotification": {
          "type": "boolean",
          "default": false,
          "description": "Optionally show an Ubuntu desktop notification via libnotify when Codex finishes. Disabled by default.",
          "scope": "machine"
        },
        "codexNotifier.previewCard": {
          "type": "boolean",
          "default": true,
          "description": "Show a bottom-left answer preview using GTK3 on X11/XWayland. Enabled by default. Uses an in-editor fallback when unavailable.",
          "scope": "machine"
        },
        "codexNotifier.previewDuration": {
          "type": "number",
          "default": 7,
          "minimum": 3,
          "maximum": 20,
          "description": "How many seconds the bottom-left answer preview card remains visible (3-20).",
          "scope": "machine"
        },
        "codexNotifier.sound": {
          "type": "boolean",
          "default": true,
          "description": "Play a sound when Codex completes a turn.",
          "scope": "machine"
        },
        "codexNotifier.soundChoice": {
          "type": "string",
          "default": "synth-2",
          "description": "Selected sound preset or imported custom sound filename.",
          "scope": "machine"
        },
        "codexNotifier.volume": {
          "type": "number",
          "default": 55,
          "minimum": 5,
          "maximum": 100,
          "description": "Notification sound volume percentage (5-100).",
          "scope": "machine"
        },
        "codexNotifier.vscodeToast": {
          "type": "boolean",
          "default": false,
          "description": "Also show an in-editor VS Code information toast notification.",
          "scope": "machine"
        },
        "codexNotifier.codexHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the local Codex home. Empty uses CODEX_HOME, then ~/.codex. Only the documented database schema is supported."
        },
        "codexNotifier.topBarIndicator": {
          "type": "boolean",
          "default": true,
          "description": "Show a shared Codex icon and active-chat count in the Ubuntu top bar. Requires Ayatana AppIndicator3.",
          "scope": "machine"
        },
        "codexNotifier.topBarFlash": {
          "type": "boolean",
          "default": true,
          "description": "Flash the top-bar icon in its working color while chats are active. Disable for a static icon.",
          "scope": "machine"
        },
        "codexNotifier.colors": {
          "type": "object",
          "default": {},
          "scope": "machine",
          "additionalProperties": false,
          "description": "Custom colors for the top-bar icons and bottom-left notification. Unset colors follow the defaults or VS Code theme. Use the sidebar pickers or #RRGGBB values.",
          "properties": {
            "working": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Working top-bar icon"
            },
            "finished": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Finished top-bar icon"
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Notification background"
            },
            "foreground": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Project text"
            },
            "inset": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Answer background"
            },
            "insetForeground": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Answer text"
            },
            "badgeBackground": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Codex badge background"
            },
            "badgeText": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Codex badge text"
            },
            "button": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "VS Code button background"
            },
            "buttonText": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "VS Code button text"
            },
            "muted": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Secondary notification text"
            },
            "border": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Notification border"
            }
          }
        }
      }
    }
  },
  "homepage": "https://github.com/stiansci/Codex_Ubuntu_Notifications#readme",
  "bugs": {
    "url": "https://github.com/stiansci/Codex_Ubuntu_Notifications/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Local Codex databases and desktop processes require a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "test": "node scripts/run-tests.js && python3 -m unittest discover -s test -p \"test_*.py\"",
    "package": "node scripts/package.js",
    "package:check": "python3 scripts/check-package.py",
    "assets:icons": "python3 scripts/generate-assets.py",
    "public:check": "python3 scripts/check-public.py",
    "package:marketplace": "node scripts/package.js --marketplace",
    "package:check:marketplace": "python3 scripts/check-package.py --marketplace",
    "versions": "node scripts/versions.js list",
    "version:bump": "node scripts/versions.js bump",
    "version:tag": "node scripts/versions.js tag",
    "versions:tag-history": "node scripts/versions.js tag-history",
    "version:check": "node scripts/versions.js check-tag",
    "release:prepare": "node scripts/prepare-release.js"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.0"
  },
  "vsce": {
    "dependencies": false
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
